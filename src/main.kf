import system


logoFor(String os): List<String> {
    if (os == "macOS") {
        return listOf(
            "..'                           ",
            "                 ,xNMM.       ",
            "               .OMMMMo        ",
            "               lMM\"           ",
            "      .;loddo:.  .olloddol;.  ",
            "    cKMMMMMMMMMMNWMMMMMMMMMM0:",
            "  .KMMMMMMMMMMMMMMMMMMMMMMMWd.",
            "  XMMMMMMMMMMMMMMMMMMMMMMMX.  ",
            ";MMMMMMMMMMMMMMMMMMMMMMMM:    ",
            ":MMMMMMMMMMMMMMMMMMMMMMMM:    ",
            ".MMMMMMMMMMMMMMMMMMMMMMMMMX.  ",
            " kMMMMMMMMMMMMMMMMMMMMMMMMWd. ",
            " 'XMMMMMMMMMMMMMMMMMMMMMMMMMMk",
            "  'XMMMMMMMMMMMMMMMMMMMMMMMMK.",
            "    kMMMMMMMMMMMMMMMMMMMMMMd  ",
            "     ;KMMMMMMMWXXWMMMMMMMk.   ",
            "       \"cooc*\"    \"*coo'\"     "
        )
    }

    if (os == "Linux") {
        return listOf(
            "      .--.                 ",
            "     |o_o |                ",
            "     |:_/ |                ",
            "    //   \\ \\              ",
            "   (|     | )              ",
            "  /'\\_   _/`\\             "
        )
    }

    return listOf(
        "  ┌──────────┐             ",
        "  │          │             ",
        "  │    OS    │             ",
        "  │          │             ",
        "  └──────────┘             "
    )
}

logoColor(String os, Int line): String {
    if (os == "macOS") {
        if (line < 6) return "\u001B[38;5;46m"
        if (line < 8) return "\u001B[38;5;226m"
        if (line < 10) return "\u001B[38;5;203m"
        if (line < 12) return "\u001B[38;5;196m"
        if (line < 14) return "\u001B[38;5;201m"

        return "\u001B[38;5;39m"
    }

    if (os == "Linux") {
        return "\u001B[38;5;45m"
    }

    return "\u001B[97m"
}

main() {
    var system = collectSystemInfo()
    var logo = logoFor(system.os())

    var reset = "\u001B[0m"
    var accent = "\u001B[38;5;45m"
    var title = "\u001B[1;38;5;213m"

    var info = listOf(
        title + system.user() + "@" + system.shortHost() + reset,
        "──────────────────────────────",
        accent + "OS:" + reset + "       " + system.os(),
        accent + "Arch:" + reset + "     " + system.arch(),
        accent + "Shell:" + reset + "    " + system.shell(),
        accent + "Host:" + reset + "     " + system.host(),
        accent + "Uptime:" + reset + "   " + system.uptime(),
        accent + "Kof:" + reset + "      " + system.kofVersion()
    )

    var total = logo.size

    if (info.size > total) {
        total = info.size
    }

    var i = 0

    while (i < total) {
        if (i < logo.size && i < info.size) {
            println(
                logoColor(system.os(), i)
                + logo.get(i)
                + reset
                + "     "
                + info.get(i)
            )
        } else if (i < logo.size) {
            println(
                logoColor(system.os(), i)
                + logo.get(i)
                + reset
            )
        } else {
            println(
                "                                   "
                + info.get(i)
            )
        }

        i = i + 1
    }
}