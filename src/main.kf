import system
import


main() {
    var system = collectSystemInfo()
    var logo = logoFor(system.os())

    var reset = resetColor()
    var accent = accentColor()
    var title = titleColor()

    var info = listOf(
        title + system.user() + "@" + system.shortHost() + reset,
        "──────────────────────────────",
        accent + "OS:" + reset + "       " + system.os(),
        accent + "Arch:" + reset + "     " + system.arch(),
        accent + "Shell:" + reset + "    " + system.shell(),
        accent + "Host:" + reset + "     " + system.host(),
        accent + "Uptime:" + reset + "   " + system.uptime(),
        accent + "Kof:" + reset + "      " + system.kofVersion()
    )  
    
    renderFetch(system.os(), logo, info)
}