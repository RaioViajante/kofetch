record SystemInfo(
    String os,
    String osVersion,
    String model,
    String kernel,
    String arch,
    String shell,
    String host,
    String user,
    String shortHost,
    String uptime,
    String kofVersion
)

detectOs(): String {
    var raw = process.run("uname", "-s").stdout.trim()

    if (raw == "Darwin") return "macOS"
    if (raw == "Linux") return "Linux"

    return raw
}

detectOsVersion(String os): String {
    if (os == "macOS") {
        return process.run("sw_vers", "-productVersion").stdout.trim()
    }

    return ""
}

detectModel(String os): String {
    if (os == "macOS") {
        var model = process.run(
            "sh",
            "-c",
            "system_profiler SPHardwareDataType | awk -F': ' '/Model Name/ {print $2; exit}'"
        ).stdout.trim()

        var chip = process.run(
            "sh",
            "-c",
            "system_profiler SPHardwareDataType | awk -F': ' '/Chip/ {print $2; exit}'"
        ).stdout.trim()

        return model + " (" + chip + ")"
    }

    return "Unknown"
}

detectKernel(): String {
    return process.run("uname", "-sr").stdout.trim()
}

collectSystemInfo(): SystemInfo {
    var os = detectOs()

    var osVersion = detectOsVersion(os)
    var model = detectModel(os)
    var kernel = detectKernel()

    var arch = process.run("uname", "-m").stdout.trim()
    var shell = process.run("sh", "-c", "basename \"$SHELL\"").stdout.trim()
    var host = process.run("hostname").stdout.trim()
    var user = process.run("whoami").stdout.trim()
    var shortHost = process.run("hostname", "-s").stdout.trim()

    var uptime = process.run(
        "sh",
        "-c",
        "uptime | sed 's/.* up //' | sed 's/, [0-9][0-9]* users.*//'"
    ).stdout.trim()

    var kofVersion = process.run(
        "sh",
        "-c",
        "kof version | sed 's/^kof //'"
    ).stdout.trim()

    return SystemInfo(
        os,
        osVersion,
        model,
        kernel,
        arch,
        shell,
        host,
        user,
        shortHost,
        uptime,
        kofVersion
    )
}