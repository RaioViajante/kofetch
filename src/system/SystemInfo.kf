record SystemInfo(
    String os,
    String platform,
    String osVersion,
    String model,
    String kernel,
    String arch,
    String cpu,
    String memory,
    String terminal,
    String disk,
    String battery,
    String shell,
    String host,
    String user,
    String shortHost,
    String uptime,
    String kofVersion
)

detectOs(): String {
    var info = process.run("kof", "info").stdout

    if (containsText(info, "OS: macos")) return "macOS"
    if (containsText(info, "OS: linux")) return "Linux"
    if (containsText(info, "OS: windows")) return "Windows"

    return "Unknown"
}

detectOsVersion(String os): String {
    if (os == "macOS") {
        return process.run("sw_vers", "-productVersion").stdout.trim()
    }

    if (os == "Linux") {
        return process.run(
            "sh",
            "-c",
            ". /etc/os-release 2>/dev/null; printf '%s' \"${PRETTY_NAME:-Linux}\""
        ).stdout.trim()
    }

    if (os == "Windows") {
        return runPowerShell(
            "Write-Output (Get-CimInstance Win32_OperatingSystem).Caption"
        )
    }

    return ""
}

detectModel(String os): String {
    if (os == "macOS") {
        var model = process.run(
            "sh",
            "-c",
            "system_profiler SPHardwareDataType | awk -F': ' '/Model Name/ {print $2; exit}'"
        ).stdout.trim()

        var chip = process.run(
            "sh",
            "-c",
            "system_profiler SPHardwareDataType | awk -F': ' '/Chip/ {print $2; exit}'"
        ).stdout.trim()

        return model + " (" + chip + ")"
    }

    if (os == "Linux") {
        var model = process.run(
            "sh",
            "-c",
            "cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null"
        ).stdout.trim()

        if (model == "") return "Unknown"

        return model
    }

    if (os == "Windows") {
        return runPowerShell(
            "$c = Get-CimInstance Win32_ComputerSystem; Write-Output ($c.Manufacturer + ' ' + $c.Model)"
        )
    }

    return "Unknown"
}

detectKernel(String os): String {
    if (os == "Windows") {
        return runPowerShell(
            "Write-Output ('Windows NT ' + (Get-CimInstance Win32_OperatingSystem).Version)"
        )
    }

    return process.run("uname", "-sr").stdout.trim()
}

detectCpu(String os): String {
    if (os == "macOS") {
        var name = process.run(
            "sh",
            "-c",
            "sysctl -n machdep.cpu.brand_string 2>/dev/null || sysctl -n hw.model"
        ).stdout.trim()

        var cores = process.run(
            "sysctl",
            "-n",
            "hw.ncpu"
        ).stdout.trim()

        return name + " (" + cores + " cores)"
    }

    if (os == "Linux") {
        var name = process.run(
            "sh",
            "-c",
            "lscpu | awk -F: '/Model name/ {gsub(/^[ \t]+/, \"\", $2); print $2; exit}'"
        ).stdout.trim()

        var cores = process.run(
            "sh",
            "-c",
            "lscpu -p=Core,Socket | grep -v '^#' | sort -u | wc -l | tr -d ' '"
        ).stdout.trim()

        var threads = process.run("nproc").stdout.trim()

        if (name == "") return "Unknown"

        return name + " (" + cores + " cores, " + threads + " threads)"
    }

    if (os == "Windows") {
        return runPowerShell(
            "$cpu = Get-CimInstance Win32_Processor | Select-Object -First 1; " +
            "Write-Output ($cpu.Name.Trim() + ' (' + $cpu.NumberOfCores + ' cores, ' + $cpu.NumberOfLogicalProcessors + ' threads)')"
        )
    }

    return "Unknown"
}

detectMemory(String os): String {
    if (os == "macOS") {
        return process.run(
            "sh",
            "-c",
            "total=$(sysctl -n hw.memsize); page=$(vm_stat | awk 'NR==1 {print $8}'); free=$(vm_stat | awk '/Pages free/ {gsub(/\\./, \"\", $3); print $3}'); inactive=$(vm_stat | awk '/Pages inactive/ {gsub(/\\./, \"\", $3); print $3}'); speculative=$(vm_stat | awk '/Pages speculative/ {gsub(/\\./, \"\", $3); print $3}'); used=$((total - (free + inactive + speculative) * page)); awk -v used=\"$used\" -v total=\"$total\" 'BEGIN {printf \"%.1f GiB / %.1f GiB\", used / 1073741824, total / 1073741824}'"
        ).stdout.trim()
    }

    if (os == "Linux") {
        return process.run(
            "sh",
            "-c",
            "free -b | awk '/Mem:/ {printf \"%.1f GiB / %.1f GiB\", $3 / 1073741824, $2 / 1073741824}'"
        ).stdout.trim()
    }

    if (os == "Windows") {
        return runPowerShell(
            "$os = Get-CimInstance Win32_OperatingSystem; " +
            "$total = $os.TotalVisibleMemorySize * 1KB; " +
            "$free = $os.FreePhysicalMemory * 1KB; " +
            "$used = $total - $free; " +
            "Write-Output ('{0:N1} GiB / {1:N1} GiB' -f ($used / 1GB), ($total / 1GB))"
        )
    }

    return "Unknown"
}

detectTerminal(String os): String {
    if (os == "Windows") {
        var terminal = runPowerShell(
            "if ($env:TERM_PROGRAM -eq 'vscode') { " +
            "Write-Output 'Visual Studio Code' " +
            "} elseif ($env:WT_SESSION) { " +
            "Write-Output 'Windows Terminal' " +
            "} else { " +
            "Write-Output 'Unknown' " +
            "}"
        )

        return terminal
    }

    var terminal = process.run(
        "sh",
        "-c",
        "printf '%s' \"${TERM_PROGRAM:-}\""
    ).stdout.trim()

    if (terminal == "vscode") return "Visual Studio Code"
    if (terminal == "Apple_Terminal") return "Terminal.app"
    if (terminal == "iTerm.app") return "iTerm2"
    if (terminal != "") return terminal

    if (os == "Linux") {
        var ptyxisVersion = process.run(
            "sh",
            "-c",
            "printf '%s' \"${PTYXIS_VERSION:-}\""
        ).stdout.trim()

        if (ptyxisVersion != "") {
            return "Ptyxis " + ptyxisVersion
        }
    }

    return "Unknown"
}

detectDisk(String os): String {
    if (os == "macOS") {
        return process.run(
            "sh",
            "-c",
            "df -k / | awk 'NR==2 {printf \"%.1f GiB / %.1f GiB\", $3 / 1048576, $2 / 1048576}'"
        ).stdout.trim()
    }

    if (os == "Linux") {
        return process.run(
            "sh",
            "-c",
            "df -B1 / | awk 'NR==2 {printf \"%.1f GiB / %.1f GiB\", $3 / 1073741824, $2 / 1073741824}'"
        ).stdout.trim()
    }

    if (os == "Windows") {
        return runPowerShell(
            "$drive = Get-CimInstance Win32_LogicalDisk -Filter \"DeviceID='$env:SystemDrive'\"; " +
            "$used = $drive.Size - $drive.FreeSpace; " +
            "Write-Output ('{0:N1} GiB / {1:N1} GiB' -f ($used / 1GB), ($drive.Size / 1GB))"
        )
    }

    return "Unknown"
}

detectBattery(String os): String {
    if (os == "macOS") {
        var battery = process.run(
            "sh",
            "-c",
            "pmset -g batt | grep -Eo '[0-9]+%' | head -1"
        ).stdout.trim()

        if (battery == "") return "Unknown"

        return battery
    }

    if (os == "Linux") {
        var battery = process.run(
            "sh",
            "-c",
            "for bat in /sys/class/power_supply/BAT*; do if [ -f \"$bat/capacity\" ]; then printf '%s%%' \"$(cat \"$bat/capacity\")\"; break; fi; done"
        ).stdout.trim()

        if (battery == "") return "N/A"

        return battery
    }

    if (os == "Windows") {
        var battery = runPowerShell(
            "$battery = Get-CimInstance Win32_Battery | Select-Object -First 1; " +
            "if ($null -eq $battery) { Write-Output 'N/A' } else { Write-Output ($battery.EstimatedChargeRemaining.ToString() + '%') }"
        )

        if (battery == "") return "N/A"

        return battery
    }

    return "Unknown"
}

detectPlatform(String os): String {
    if (os == "macOS") {
        return "macos"
    }

    if (os == "Linux") {
        var distro = process.run(
            "sh",
            "-c",
            ". /etc/os-release 2>/dev/null; printf '%s' \"${ID:-linux}\""
        ).stdout.trim()

        if (distro == "") return "linux"

        return distro
    }

    if (os == "Windows") {
        return "windows"
    }

    return "unknown"
}

detectUptime(String os): String {
    if (os == "macOS") {
        return process.run(
            "sh",
            "-c",
            "uptime | sed 's/.* up //' | sed 's/, [0-9][0-9]* users.*//'"
        ).stdout.trim()
    }

    if (os == "Linux") {
        return process.run(
            "sh",
            "-c",
            "uptime -p | sed 's/^up //'"
        ).stdout.trim()
    }

    if (os == "Windows") {
        return runPowerShell(
            "$boot = (Get-CimInstance Win32_OperatingSystem).LastBootUpTime; " +
            "$span = (Get-Date) - $boot; " +
            "if ($span.Days -gt 0) { " +
            "Write-Output ($span.Days.ToString() + ' days, ' + $span.Hours.ToString() + ' hours, ' + $span.Minutes.ToString() + ' minutes') " +
            "} else { " +
            "Write-Output ($span.Hours.ToString() + ' hours, ' + $span.Minutes.ToString() + ' minutes') " +
            "}"
        )
    }

    return "Unknown"
}

containsText(String text, String needle): Bool {
    if (needle.length == 0) return true
    if (needle.length > text.length) return false

    var i = 0

    while (i <= text.length - needle.length) {
        if (text.substring(i, i + needle.length) == needle) {
            return true
        }

        i = i + 1
    }

    return false
}

runPowerShell(String command): String {
    return process.run(
        "powershell",
        "-NoProfile",
        "-Command",
        command
    ).stdout.trim()
}

detectArch(String os): String {
    if (os == "Windows") {
        return runPowerShell(
            "Write-Output $env:PROCESSOR_ARCHITECTURE"
        )
    }

    return process.run("uname", "-m").stdout.trim()
}

detectShell(String os): String {
    if (os == "Windows") {
        return "PowerShell"
    }

    return process.run(
        "sh",
        "-c",
        "basename \"$SHELL\""
    ).stdout.trim()
}

detectHost(String os): String {
    if (os == "Windows") {
        return runPowerShell(
            "Write-Output $env:COMPUTERNAME"
        )
    }

    return process.run("hostname").stdout.trim()
}

detectUser(String os): String {
    if (os == "Windows") {
        return runPowerShell(
            "Write-Output $env:USERNAME"
        )
    }

    return process.run("whoami").stdout.trim()
}

detectShortHost(String os): String {
    if (os == "Windows") {
        return runPowerShell(
            "Write-Output $env:COMPUTERNAME"
        )
    }

    return process.run("hostname", "-s").stdout.trim()
}

detectKofVersion(String os): String {
    if (os == "Windows") {
        return runPowerShell(
            "(kof version) -replace '^kof ', ''"
        )
    }

    return process.run(
        "sh",
        "-c",
        "kof version | sed 's/^kof //'"
    ).stdout.trim()
}

collectSystemInfo(): SystemInfo {
    var os = detectOs()
    var platform = detectPlatform(os)

    var osVersion = detectOsVersion(os)
    var model = detectModel(os)
    var kernel = detectKernel(os)
    var arch = detectArch(os)
    var cpu = detectCpu(os)
    var memory = detectMemory(os)
    var terminal = detectTerminal(os)
    var disk = detectDisk(os)
    var battery = detectBattery(os)
    var shell = detectShell(os)
    var host = detectHost(os)
    var user = detectUser(os)
    var shortHost = detectShortHost(os)
    var uptime = detectUptime(os)
    var kofVersion = detectKofVersion(os)

    return SystemInfo(
        os,
        platform,
        osVersion,
        model,
        kernel,
        arch,
        cpu,
        memory,
        terminal,
        disk,
        battery,
        shell,
        host,
        user,
        shortHost,
        uptime,
        kofVersion
    )
}