record SystemInfo(
    String os,
    String arch,
    String shell,
    String host,
    String user,
    String shortHost,
    String uptime,
    String kofVersion
)

detectOs(): String {
    var raw = process.run("uname", "-s").stdout.trim()

    if (raw == "Darwin") return "macOS"
    if (raw == "Linux") return "Linux"

    return raw
}

collectSystemInfo(): SystemInfo {
    var os = detectOs()
    var arch = process.run("uname", "-m").stdout.trim()
    var shell = process.run("sh", "-c", "basename \"$SHELL\"").stdout.trim()
    var host = process.run("hostname").stdout.trim()
    var user = process.run("whoami").stdout.trim()
    var shortHost = process.run("hostname", "-s").stdout.trim()

    var uptime = process.run(
        "sh",
        "-c",
        "uptime | sed 's/.* up //' | sed 's/, [0-9][0-9]* users.*//'"
    ).stdout.trim()

    var kofVersion = process.run(
        "sh",
        "-c",
        "kof version | sed 's/^kof //'"
    ).stdout.trim()

    return SystemInfo(
        os,
        arch,
        shell,
        host,
        user,
        shortHost,
        uptime,
        kofVersion
    )
}