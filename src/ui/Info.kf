import system

displayOs(SystemInfo system): String {
    if (system.os() == "Linux") {
        return system.osVersion()
    }

    return system.os() + " " + system.osVersion()
}

buildInfo(SystemInfo system): List<String> {
    var reset = resetColor()
    var accent = accentColor()
    var title = titleColor()

    return listOf(
        title + system.user() + "@" + system.shortHost() + reset,
        "──────────────────────────────",
        accent + "OS:" + reset + "       " + displayOs(system),
        accent + "Host:" + reset + "     " + system.model(),
        accent + "Kernel:" + reset + "   " + system.kernel(),
        accent + "Arch:" + reset + "     " + system.arch(),
        accent + "CPU:" + reset + "      " + system.cpu(),
        accent + "Memory:" + reset + "   " + system.memory(),
        accent + "Disk:" + reset + "     " + system.disk(),
        accent + "Battery:" + reset + "  " + system.battery(),
        accent + "Uptime:" + reset + "   " + system.uptime(),
        accent + "Shell:" + reset + "    " + system.shell(),
        accent + "Terminal:" + reset + " " + system.terminal(),
        accent + "Kof:" + reset + "      " + system.kofVersion(),
        "",
        paletteNormal(),
        paletteBright()
    )
}