logoFor(String platform): List<String> {
    if (platform == "macos") {
        return listOf(
            "..'                           ",
            "                 ,xNMM.       ",
            "               .OMMMMo        ",
            "               lMM\"           ",
            "      .;loddo:.  .olloddol;.  ",
            "    cKMMMMMMMMMMNWMMMMMMMMMM0:",
            "  .KMMMMMMMMMMMMMMMMMMMMMMMWd.",
            "  XMMMMMMMMMMMMMMMMMMMMMMMX.  ",
            ";MMMMMMMMMMMMMMMMMMMMMMMM:    ",
            ":MMMMMMMMMMMMMMMMMMMMMMMM:    ",
            ".MMMMMMMMMMMMMMMMMMMMMMMMMX.  ",
            " kMMMMMMMMMMMMMMMMMMMMMMMMWd. ",
            " 'XMMMMMMMMMMMMMMMMMMMMMMMMMMk",
            "  'XMMMMMMMMMMMMMMMMMMMMMMMMK.",
            "    kMMMMMMMMMMMMMMMMMMMMMMd  ",
            "     ;KMMMMMMMWXXWMMMMMMMk.   ",
            "       \"cooc*\"    \"*coo'\"     "
        )
    }

    if (platform == "ubuntu") {
        return ubuntuLogo()
    }

    if (platform == "debian") {
        return debianLogo()
    }

    if (platform == "arch") {
        return archLogo()
    }

    if (platform == "fedora") {
        return fedoraLogo()
    }

    if (platform == "linux") {
        return listOf(
            "      .--.                 ",
            "     |o_o |                ",
            "     |:_/ |                ",
            "    //   \\ \\              ",
            "   (|     | )              ",
            "  /'\\_   _/`\\             "
        )
    }

    return listOf(
        "  ┌──────────┐             ",
        "  │          │             ",
        "  │    OS    │             ",
        "  │          │             ",
        "  └──────────┘             "
    )
}

logoColor(String platform, Int line): String {
    if (platform == "macos") {
        if (line < 6) return "\u001B[38;5;46m"
        if (line < 8) return "\u001B[38;5;226m"
        if (line < 10) return "\u001B[38;5;203m"
        if (line < 12) return "\u001B[38;5;196m"
        if (line < 14) return "\u001B[38;5;201m"

        return "\u001B[38;5;39m"
    }

    if (platform == "ubuntu") {
        return "\u001B[38;5;208m"
    }

    if (platform == "debian") {
        return "\u001B[38;5;197m"
    }

    if (platform == "arch") {
        return "\u001B[38;5;39m"
    }

    if (platform == "fedora") {
        return "\u001B[38;5;33m"
    }

    if (platform == "linux") {
        return "\u001B[38;5;45m"
    }

    return "\u001B[97m"
}