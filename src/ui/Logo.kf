        "ccccc:XM0';cccc;MMM.;cccccccccccc",
        "ccccc;MMo;ccccc;MMW.;cccccccccccc",
        "ccccc;0MNc.ccc.xMMd;ccccccccccccc",
        "cccccc;dNMWXXXWM0:;cccccccccccccc",
        "cccccccc;.:odl:.;cccccccccccccccc",
