archLogo(): List<String> {
    return listOf(
        "                   -`          ",
        "                  .o+`          ",
        "                 `ooo/          ",
        "                `+oooo:         ",
        "               `+oooooo:        ",
        "               -+oooooo+:       ",
        "             `/:-:++oooo+:      ",
        "            `/++++/+++++++:     ",
        "           `/++++++++++++++:    ",
        "          `/+++ooooooooooooo/`  ",
        "         ./ooosssso++osssssso+` ",
        "        .oossssso-````/ossssss+`",
        "       -osssssso.      :ssssssso.",
        "      :osssssss/        osssso+++",
        "     /ossssssss/        +ssssooo/",
        "   `/ossssso+/:-        -:/+osss.",
        "  `+sso+:-`                 `.-/+",
        " `++:.                         `-",
        " .`                              "
    )
}

