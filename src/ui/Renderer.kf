padEnd(String text, Int width): String {
    var result = text

    while (result.length < width) {
        result = result + " "
    }

    return result
}

renderFetch(String platform, List<String> logo, List<String> info) {
    var reset = resetColor()
    var logoWidth = 38
    var gap = "    "

    var total = logo.size

    if (info.size > total) {
        total = info.size
    }

    var i = 0

    while (i < total) {
        if (i < logo.size && i < info.size) {
            println(
                logoColor(platform, i)
                + padEnd(logo.get(i), logoWidth)
                + reset
                + gap
                + info.get(i)
            )
        } else if (i < logo.size) {
            println(
                logoColor(platform, i)
                + logo.get(i)
                + reset
            )
        } else {
            println(
                padEnd("", logoWidth)
                + gap
                + info.get(i)
            )
        }

        i = i + 1
    }
}